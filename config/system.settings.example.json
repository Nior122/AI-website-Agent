{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Non-secret example settings for future implementations. Copy to system.settings.local.json only when an approved runtime needs local overrides.",
  "target": {
    "country": null,
    "city": null,
    "niche": null
  },
  "limits": {
    "dailyLeadLimit": 10
  },
  "scout": {
    "mode": "approved_manual_review_only",
    "defaultLeadLimit": 5,
    "approvedSources": ["openstreetmap_overpass"],
    "allowLiveDiscovery": true,
    "realDataRequiresReviewOnly": true,
    "maxCandidatesPerRun": 5,
    "maxRequestsPerSourceRun": 1,
    "requestTimeoutSeconds": 30,
    "approvedPilot": {"country": "Nigeria", "city": "Lagos", "niche": "Restaurants"}
  },
  "research": {
    "mode": "dry_run_only",
    "approvedSources": [],
    "allowLiveResearch": false,
    "requiresSourceProvenance": true,
    "requiresHumanReviewForSubjectiveWebsiteEvaluation": true,
    "liveResearchRequiresEnvironmentVariable": "AI_WEBSITE_AGENT_ALLOW_LIVE_RESEARCH",
    "maxPagesPerCandidate": 2,
    "maxRequestsPerRun": 6,
    "requestTimeoutSeconds": 12,
    "maxResponseBytes": 400000,
    "minDelaySeconds": 1.0,
    "maxRedirects": 3,
    "maxRetries": 1,
    "respectRobotsTxt": true,
    "fetchPlatformProfiles": false,
    "allowHosts": [],
    "_liveResearchNotes": "Bounds for research/live_source.py only. Only the pages already recorded on the candidate are read, robots.txt is honored, a login wall or block is recorded as our limitation and never as a finding about the business, and platform profiles stay unfetched unless a host is explicitly allowlisted here and fetchPlatformProfiles is true. allowLiveResearch true is necessary but not sufficient: the environment variable must also be set."
  },
  "templates": {
    "mode": "local_demo_only",
    "defaultTemplate": null,
    "requireAccessibleAltText": true,
    "allowExternalImages": false
  },
  "builder": {
    "mode": "local_preview_only",
    "outputRoot": "output",
    "contentGenerator": "deterministic-fallback",
    "allowProviderGeneration": false,
    "requireQualifiedResearch": true,
    "requireValidationBeforeArtifact": true
  },
  "validation": {
    "mode": "local_static_only",
    "requirePassBeforeDeployment": true,
    "allowWarningsWithExplicitApproval": false,
    "enableBrowserChecks": false,
    "placeholderPatterns": ["Lorem ipsum", "Demo Business", "Example Company", "Your Business Name"]
  },
  "tracking": {
    "mode": "local_json_or_supabase_postgres",
    "statePath": "data/tracking/state.json",
    "databaseUrlEnvironmentVariable": "DATABASE_URL",
    "storageBackendEnvironmentVariable": "AI_WEBSITE_AGENT_STORAGE_BACKEND",
    "migrationFile": "migrations/0001_supabase_postgres_schema.sql",
    "allowManualStateEdits": false
  },
  "orchestration": {
    "mode": "local_job_ledger_only",
    "maxAttempts": 3,
    "concurrencyLimit": 1,
    "staleJobTimeoutSeconds": 900,
    "allowN8nCoordination": false,
    "apiBindHost": "127.0.0.1",
    "apiPortEnvironmentVariable": "PORT",
    "allowNonLoopbackEnvironmentVariable": "AI_WEBSITE_AGENT_ALLOW_NON_LOOPBACK",
    "apiTokenEnvironmentVariable": "AI_WEBSITE_AGENT_API_TOKEN",
    "livenessEndpoint": "/healthz"
  },
  "workers": {
    "mode": "registry_and_mock_only",
    "leaseSeconds": 300,
    "heartbeatTimeoutSeconds": 90,
    "maxConcurrentMutatingJobsPerProject": 1,
    "routingPreferences": {},
    "costClasses": ["FREE", "LOW", "STANDARD", "PREMIUM"]
  },
  "qualification": {
    "considerNoProfessionalWebsite": true,
    "considerOutdatedOrPoorWebsite": true,
    "requireActiveOnlinePresence": true,
    "requiresHumanReviewBeforeOutreach": true,
    "opportunityMinimumScore": 60,
    "requiresTwoIndependentSourcesForAutomaticQualification": true,
    "missingDirectoryWebsiteFieldMeans": "WEBSITE_UNKNOWN"
  },
  "outreach": {
    "mode": "draft_only",
    "allowedChannels": ["EMAIL", "WHATSAPP", "INSTAGRAM", "FACEBOOK", "LINKEDIN", "SMS", "OTHER"],
    "requireQualifiedLead": true,
    "requirePassValidation": true,
    "requirePreviewDeployment": true,
    "requireHumanReview": true,
    "allowSending": false,
    "sendingRequiresExplicitAuthorization": true
  },
  "deployment": {
    "mode": "preview_dry_run_only",
    "previewVisibility": "not_configured",
    "provider": "vercel",
    "allowProduction": false,
    "requirePassValidation": true,
    "requireExistingProjectLink": true,
    "dryRunByDefault": true
  },
  "ai": {
    "provider": null,
    "model": null,
    "providerProfiles": [],
    "credentialsSource": "not_configured"
  },
  "automation": {
    "mode": "disabled",
    "orchestrator": null,
    "dryRun": true
  }
}
